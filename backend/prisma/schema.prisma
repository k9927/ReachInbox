generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  googleId     String        @unique
  name         String
  email        String        @unique
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  campaigns    Campaign[]
  senders      Sender[]
  emails       Email[]
  slackAccount SlackAccount?
}

model Sender {
  id                String     @id @default(uuid())
  userId            String
  email             String
  name              String?
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean    @default(false)
  smtpAuthEncrypted String?
  createdAt         DateTime   @default(now())
  campaigns         Campaign[]
  user              User       @relation(fields: [userId], references: [id])
  emails            Email[]

  @@unique([userId, email])
}

model Campaign {
  id       String @id @default(uuid())
  userId   String
  senderId String

  subject String
  body    String

  startAt     DateTime
  delayMs     Int
  hourlyLimit Int

  createdAt      DateTime @default(now())
  idempotencyKey String
  requestHash    String

  user   User          @relation(fields: [userId], references: [id])
  sender Sender        @relation(fields: [senderId], references: [id])
  emails Email[]
  outbox EmailOutbox[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

model Email {
  id          String    @id @default(uuid())
  userId      String
  senderId    String
  recipient   String
  subject     String
  body        String
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  scheduledAt DateTime
  sentAt      DateTime?

  status EmailStatus @default(SCHEDULED)

  jobId          String? @unique
  idempotencyKey String  @unique

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id])
  sender Sender       @relation(fields: [senderId], references: [id])
  outbox EmailOutbox?

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([recipient])
}

// The database is the source of truth. A dispatcher can safely retry adding
// these rows to BullMQ because every queue job uses the email ID as its job ID.
model EmailOutbox {
  id           String    @id @default(uuid())
  emailId      String    @unique
  campaignId   String
  createdAt    DateTime  @default(now())
  availableAt  DateTime  @default(now())
  dispatchedAt DateTime?
  attempts     Int       @default(0)
  lastError    String?

  email    Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, availableAt])
}

model SlackAccount {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  teamId      String?
  teamName    String?
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}
