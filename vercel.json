{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "web": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/admin/queues/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "daemons": {
    "email-worker": {
      "root": "backend/",
      "entrypoint": "Dockerfile",
      "instances": {
        "iad1": 1
      }
    }
  }
}
